{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lahmatov/anki-just-for-me/schema/deck.schema.json",
  "title": "AJFM Deck",
  "type": "object",
  "required": ["format", "version", "deck", "notes"],
  "properties": {
    "format": { "const": "ajfm-deck" },
    "version": { "type": "integer", "minimum": 1 },
    "deck": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "folder": { "type": "string" },
        "language": { "type": "string", "default": "en-US" },
        "scheduler": { "enum": ["fsrs6", "sm2", "leitner", "cram"], "default": "fsrs6" },
        "cardTypes": {
          "type": "array",
          "items": { "enum": ["recognition", "recall", "listening", "spelling", "pronunciation", "cloze"] },
          "default": ["recognition", "recall"]
        },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["term", "translation"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "translation": { "type": "string", "minLength": 1 },
          "ipa": { "type": "string" },
          "partOfSpeech": {
            "enum": ["noun", "verb", "adjective", "adverb", "phrasal verb", "idiom", "phrase", "other"]
          },
          "example": { "type": "string" },
          "exampleTranslation": { "type": "string" },
          "cloze": { "type": "string" },
          "synonyms": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "audio": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
